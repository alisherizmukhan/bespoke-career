# --- Core ---
ENV=production
DATABASE_URL=postgresql://user:pass@host:5432/db
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=https://your-frontend.example.com
PUBLIC_API_URL=https://your-api.example.com
CORS_ORIGINS=https://your-frontend.example.com

# --- Admin account created on first start ---
ADMIN_EMAIL=admin@bespoke.app
ADMIN_PASSWORD=change-me
SEED_DEMO_DATA=true

# --- AI (OpenAI by default; fast model for everyday answers, smart model for complex tasks) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MODEL_FAST=gpt-5.4-mini
# AI_PROVIDER=anthropic with ANTHROPIC_API_KEY / ANTHROPIC_MODEL is also supported

# --- Job ingestion (runs inside the API process) ---
INGEST_ENABLED=true
INGEST_INTERVAL_MINUTES=60
# Optional keyed sources (free registration); enable them in Admin → Job sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# --- Private file storage (S3-compatible, e.g. Railway Buckets); local disk if empty ---
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (verification / password reset). Without SMTP: demo mode ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Bespoke <no-reply@bespoke.app>
